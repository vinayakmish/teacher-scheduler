{
  "name": "@teacher-scheduler/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "nx serve frontend",
    "start:backend": "nx serve backend",
    "start:backend:prod": "node dist/backend/main.js",
    "build": "nx build frontend && nx build backend",
    "build:frontend": "nx build frontend",
    "build:backend": "nx build backend",
    "preview:frontend": "nx preview frontend",
    "test": "nx test",
    "test:frontend": "nx test frontend",
    "test:backend": "nx test backend",
    "test:e2e": "nx e2e frontend-e2e",
    "test:all": "npm run test:frontend && npm run test:backend && npm run test:e2e",
    "test:watch": "nx test --watch",
    "test:coverage": "nx test --coverage",
    "test:coverage:frontend": "nx test frontend --coverage",
    "test:coverage:backend": "nx test backend --coverage",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "nx run-many --target=type-check",
    "clean": "nx reset && rm -rf dist node_modules/.cache",
    "postinstall": "nx run-many --target=build --parallel"
  },
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
